# Supabase → Project Settings → Database → Connection string
# Local / migraciones: usar el "Session pooler" (puerto 5432)
# Vercel / producción: usar el "Transaction pooler" (puerto 6543) + ?pgbouncer=true
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Generado con: openssl rand -base64 32
SESSION_SECRET=""

# Firma la sesión de CLIENTE Odentia (identidad certificada por Core vía SSO,
# ver src/lib/customer-session.ts) — completamente separada de la sesión
# admin de arriba. Generado con: openssl rand -base64 32. Nunca debe tener el
# mismo valor que SESSION_SECRET.
CUSTOMER_SESSION_SECRET=""

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Sólo necesarias para `npx prisma db seed` (crea/actualiza el admin del
# panel). Sin defaults a propósito — el seed falla si faltan. La contraseña
# debe tener al menos 12 caracteres.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Resend (resend.com/api-keys) → para el correo de "olvidé mi contraseña".
RESEND_API_KEY=""
# Remitente verificado en Resend, ej: "Odentia <no-reply@odentia.co>".
# Mientras no verifiques un dominio propio, Resend solo entrega correos de
# prueba (onboarding@resend.dev) a la cuenta dueña de la API key.
RESEND_FROM_EMAIL=""

# SSO Core → Marketplace (ver src/app/auth/sso/). Server-only: nunca se
# exponen al navegador, nunca usar el prefijo NEXT_PUBLIC_.

# URL canónica de Odentia Core, ej: "https://app.odentia.com". Se usa para
# construir el endpoint de exchange server-to-server (POST
# {ODENTIA_CORE_URL}/api/sso/exchange).
ODENTIA_CORE_URL=""

# URL completa del entry point de inicio de sesión SSO en Core (aún no
# existe — pendiente de SSO E). Deliberadamente una URL completa y no solo
# una ruta, para no adivinar/hardcodear la estructura de rutas de Core
# antes de que SSO E la defina.
ODENTIA_CORE_SSO_URL=""

# URL canónica de este Marketplace, ej: "https://marketplace.odentia.com".
# Se usa para construir la callback URL que Core debe usar al redirigir de
# vuelta (nunca se confía en el header Host para esto).
MARKETPLACE_URL=""

# Secreto compartido para autenticar la llamada server-to-server al
# exchange de Core. Debe tener EXACTAMENTE el mismo valor real configurado
# en Core (mismo nombre de variable en ambos repos). Generado con:
# openssl rand -base64 32
MARKETPLACE_SSO_SHARED_SECRET=""
