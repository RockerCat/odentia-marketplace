generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String
  createdAt           DateTime  @default(now())
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id             String          @id @default(cuid())
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name           String
  slug           String          @unique
  description    String?
  brand          String?
  distributor    String?
  costPriceCents Int?
  marginPercent  Float?
  priceCents     Int
  stock          Int             @default(0)
  createdAt      DateTime        @default(now())
  images         ProductImage[]
  options        ProductOption[]
  orderItems     OrderItem[]

  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

// A simple selectable variant (e.g. "Copa", "Disco", "Punta") that shares the
// product's price and stock — not an independent SKU with its own pricing.
model ProductOption {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id              String      @id @default(cuid())
  customerName    String
  customerEmail   String
  customerPhone   String
  address         String
  notes           String?
  totalCents      Int
  status          OrderStatus @default(PENDIENTE_PAGO)
  createdAt       DateTime    @default(now())
  items           OrderItem[]
  // One idempotency key per logical checkout attempt, generated client-side
  // before the first submit and carried through retries (see checkout-form
  // and placeOrderAction). Nullable so historical orders stay valid; every
  // new checkout must supply one. The UNIQUE constraint is what actually
  // prevents a duplicate Order under a retry or a concurrent double-submit —
  // Postgres, not application logic, is the source of truth for "already
  // processed this attempt".
  idempotencyKey  String?     @unique
  // SHA-256 hash of a random per-order access token (see src/lib/order-
  // access.ts) — proves possession of the guest confirmation page
  // (/pedido/[id]/gracias) without a customer account, which doesn't exist
  // yet. The order's cuid alone is not authorization: it's a database
  // identifier, not a secret. Only the hash is ever persisted, never the
  // raw token. Nullable so historical orders created before this existed
  // stay valid rows — such an order simply has no verifier and is treated
  // as not publicly readable by ID alone (see the thank-you page's own
  // check); admins still reach it through the admin order routes, which
  // don't use this token at all.
  accessTokenHash String?     @unique
  // External Core identity, snapshotted at Order creation from the
  // server-side odentia_customer_session at that moment (see
  // src/lib/customer-session.ts) — never a local FK, since Core and
  // Marketplace are separate databases/projects. NULL on both together
  // means a guest order; non-null on both together means a Core-attributed
  // one — there is no third state (see the CHECK constraint added in this
  // column's own migration, order_core_attribution_pair).
  coreUserId      String?
  // Core's clinic id. Kept alongside coreUserId (never alone) so a future
  // "purchases by clinic" query never needs anything beyond this table —
  // see the (clinicId, createdAt) index below.
  clinicId        String?
  // The specific clinic_memberships row Core certified at the moment of
  // this Order — finer-grained than clinicId/coreUserId alone, for
  // audit/dispute resolution only; never queried on its own.
  membershipId    String?
  // Plain historical snapshot of the role Core certified at purchase time
  // (clinic_admin/dentist/assistant) — analytics/audit only, deliberately
  // a bare string rather than a Prisma enum: it is a fact about the past,
  // never re-checked for authorization anywhere in this app.
  coreRole        String?

  @@index([coreUserId])
  @@index([clinicId, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String
  optionLabel    String?
  unitPriceCents Int
  quantity       Int
  subtotalCents  Int

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDIENTE_PAGO
  PAGADO
  ENVIADO
  CANCELADO
}
